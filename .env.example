# -------------------------------------------------------------
# TikSave Studio - Environment Configuration
# -------------------------------------------------------------

# Active provider selector: 'tikwm' (default, free public API) or 'rapidapi'
TIKTOK_PROVIDER_TYPE=tikwm

# TikWM API Base URL
TIKTOK_PROVIDER_BASE_URL=https://www.tikwm.com/api/

# Optional: If TIKTOK_PROVIDER_TYPE is set to 'rapidapi'
# Obtain your key at: https://rapidapi.com/
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=tiktok-downloader-download-tiktok-videos-without-watermark.p.rapidapi.com

# Request timeout in milliseconds (default: 15000)
TIKTOK_TIMEOUT_MS=15000

# Next.js Server Port (optional, default: 3000)
PORT=3000
